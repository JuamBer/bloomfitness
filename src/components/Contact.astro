---
import { Image } from "astro:assets";
import Button from "./Button.astro";

import calendarIcon from "../assets/icons/calendar-check-solid-full.svg";
import whatsappIcon from "../assets/icons/whatsapp-brands-solid-full.svg";

const GOOGLE_FORM_URL = "https://forms.gle/uSqz9QZFbJwnyZ5fA";
---

<section id="contact" class="min-h-screen bg-black py-16">
  <div class="container mx-auto px-4">
    <div class="max-w-4xl mx-auto mb-6 text-center">
      <div class="inline-flex bg-white p-4 rounded-full mb-6">
        <Image src={calendarIcon} alt="" class="w-10 h-10" loading="lazy" />
      </div>
      <h2
        class="text-white text-3xl md:text-4xl font-extrabold uppercase tracking-tight mb-4"
      >
        Cuéntanos tus objetivos
      </h2>
      <p class="text-gray-300 text-base md:text-lg max-w-2xl mx-auto mb-8">
        Rellena el formulario con tus datos y tus dudas, y nuestro equipo se
        pondrá en contacto contigo para resolverlas y, si quieres, agendar tu
        primera cita.
      </p>
      <Button
        href={GOOGLE_FORM_URL}
        target="_blank"
        rel="noopener noreferrer"
        color="red"
        size="lg"
      >
        Rellenar formulario
        <svg
          class="w-5 h-5 group-hover:translate-x-1 transition-transform duration-300"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
        </svg>
      </Button>
    </div>

    <div class="max-w-4xl mx-auto mb-16">
      <a
        href="https://wa.me/+34614047269"
        target="_blank"
        rel="noopener noreferrer"
        class="block bg-gradient-to-r from-[#25D366] to-[#20BA5A] rounded-xl p-6 shadow-xl hover:shadow-2xl transition-all duration-300 transform hover:scale-[1.02] group"
      >
        <div
          class="flex flex-col sm:flex-row items-center justify-between gap-4"
        >
          <div class="flex items-center gap-4 text-white">
            <div class="bg-white p-3 rounded-full">
              <Image
                src={whatsappIcon}
                alt="WhatsApp"
                class="w-8 h-8"
                style="filter: brightness(0) saturate(100%) invert(50%) sepia(89%) saturate(1637%) hue-rotate(98deg) brightness(94%) contrast(89%);"
                loading="lazy"
              />
            </div>
            <div>
              <p class="font-bold text-xl uppercase tracking-wide">
                ¿Prefieres WhatsApp?
              </p>
              <p class="text-base opacity-90">
                Chatea directamente con nosotros
              </p>
            </div>
          </div>
          <div
            class="flex items-center gap-2 text-white font-bold text-lg uppercase tracking-wide group-hover:gap-3 transition-all duration-300"
          >
            <span>Abrir Chat</span>
            <svg
              class="w-6 h-6 group-hover:translate-x-1 transition-transform duration-300"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </div>
        </div>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 pt-8">
      <div class="text-left">
        <p class="text-gray-300 text-base sm:text-xl">
          <span class="font-medium">BLOOM FITNESS</span>
          <a
            href="tel:+34614047269"
            class="font-bold text-white hover:text-[var(--color-orange-strong)] transition-colors duration-300 inline-block"
            >+34 614 04 72 69</a
          >
        </p>
      </div>
      <div class="text-left md:text-right">
        <p class="text-gray-300 text-base sm:text-xl">
          <span class="font-medium">PZA MÚSICO IBARS, 5,</span>
          <a
            href="https://maps.app.goo.gl/iUTmr8QdNCauKDrA7"
            target="_blank"
            rel="noopener noreferrer"
            class="font-bold text-white hover:text-[var(--color-orange-strong)] transition-colors duration-300 inline-block"
            >MISLATA, VALENCIA</a
          >
        </p>
      </div>
    </div>
  </div>
</section>
