---
import arrowRight from "../../assets/icons/arrow-right-solid-full.svg";
import percent from "../../assets/icons/percent-solid-full.svg";
import Button from "../../components/Button.astro";
import ColorBar from "../../components/ColorBar.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import PhysioVariantCard from "../../components/PhysioVariantCard.astro";
import ProfessionalsSidebar from "../../components/ProfessionalsSidebar.astro";
import { ProfessionalArea, professionals } from "../../data/professionals";
import Layout from "../../layouts/Layout.astro";

const physios = professionals.filter(
  (p) => p.area === ProfessionalArea.FISIOTERAPIA,
);
const physioServiceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Fisioterapia en Mislata",
  serviceType: "Fisioterapia",
  areaServed: {
    "@type": "City",
    name: "Mislata",
  },
  provider: {
    "@type": "HealthAndBeautyBusiness",
    name: "Bloom Fitness",
    url: "https://bloomfitness.es",
    telephone: "+34 614 047 269",
    address: {
      "@type": "PostalAddress",
      streetAddress: "Plaza Musico Ibars numero 5",
      addressLocality: "Mislata",
      addressRegion: "Valencia",
      postalCode: "46920",
      addressCountry: "ES",
    },
  },
  offers: {
    "@type": "Offer",
    priceCurrency: "EUR",
    price: "32",
    description: "Sesiones de fisioterapia desde 32 EUR",
  },
  url: "https://bloomfitness.es/servicios/fisioterapia",
};

const physioFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Cuanto cuesta la fisioterapia en Mislata?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Puedes empezar desde 45 euros en sesion de seguimiento o elegir bonos y programas para reducir el coste por sesion.",
      },
    },
    {
      "@type": "Question",
      name: "Trabajais recuperacion de lesiones deportivas?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Si. Adaptamos el tratamiento y la readaptacion segun evolucion para volver a tu actividad con mayor seguridad.",
      },
    },
  ],
};
---

<Layout
  title="Fisioterapia en Mislata para Dolor y Lesiones | Bloom Fitness"
  description="Fisioterapia en Mislata para dolor, lesiones y readaptacion. Sesiones, bonos y programas con seguimiento profesional en Bloom Fitness."
  keywords="fisioterapia Mislata, fisioterapeuta Mislata, rehabilitacion Mislata, dolor espalda Mislata, lesion deportiva Mislata, Bloom Fitness"
>
  <script type="application/ld+json" set:html={JSON.stringify(physioServiceSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(physioFaqSchema)}></script>
  <Header />
  <ColorBar />

  <main class="min-h-screen bg-black pt-16 pb-16">
    <nav class="max-w-7xl mx-auto px-6 md:px-12 mb-8" aria-label="Migas de pan">
      <ol class="flex items-center gap-2 text-sm">
        <li>
          <a
            href="/servicios"
            class="text-gray-400 hover:text-[var(--color-blue)] transition-colors"
          >
            Servicios
          </a>
        </li>
        <li class="text-gray-600">/</li>
        <li class="text-[var(--color-blue)] font-semibold">Fisioterapia</li>
      </ol>
    </nav>

    <section class="max-w-7xl mx-auto px-6 md:px-12 mb-16">
      <span
        class="text-[var(--color-blue)] uppercase tracking-wider font-bold text-sm mb-2 block"
        transition:name="servicio-numero-02">02</span
      >
      <h1
        class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-wider text-white uppercase mb-8"
        transition:name="servicio-nombre-fisioterapia"
      >
        FISIOTERAPIA <span class="text-[var(--color-blue)]">EN MISLATA</span>
      </h1>
      <p class="text-gray-300 text-lg md:text-xl max-w-3xl leading-relaxed">
        Servicio de fisioterapia profesional en Mislata para tratamiento,
        recuperación y prevención de lesiones. Ofrecemos sesiones individuales,
        bonos y programas completos con seguimiento personalizado.
      </p>
      <p class="text-gray-400 text-base md:text-lg max-w-3xl leading-relaxed mt-4">
        Si buscas fisioterapeuta en Mislata para aliviar dolor, recuperar movilidad
        y volver a entrenar con seguridad, te ayudamos con un plan progresivo.
      </p>
    </section>

    <div
      class="max-w-7xl mx-auto px-6 md:px-12 mb-16 grid md:grid-cols-12 gap-8 lg:gap-12"
    >
      <div class="md:col-span-4 lg:col-span-3 order-last md:order-first">
        <ProfessionalsSidebar
          professionals={physios}
          title="Nuestro Fisioterapeuta"
          color="text-[var(--color-blue)]"
        />
      </div>
      <div class="md:col-span-8 lg:col-span-9 space-y-16">
        <section>
          <h2
            class="text-white font-bold text-2xl uppercase tracking-wide mb-6 flex items-center gap-3"
          >
            <span class="w-8 h-[2px] bg-[var(--color-blue)] inline-block"
            ></span>
            Sesiones
          </h2>
          <p class="text-gray-500 text-xs mb-4">
            Elige entre en centro o a domicilio en cada tarjeta.
          </p>
          <div class="grid sm:grid-cols-2 gap-6 max-w-2xl">
            <PhysioVariantCard
              id="sesion-completa"
              label="Sesión Completa"
              priceCenter={45}
              priceDomicilio={50}
            />
            <PhysioVariantCard
              id="sesion-seguimiento"
              label="Sesión Seguimiento"
              priceCenter={32}
              priceDomicilio={37}
            />
          </div>
        </section>

        <section>
          <h2
            class="text-white font-bold text-2xl uppercase tracking-wide mb-6 flex items-center gap-3"
          >
            <span class="w-8 h-[2px] bg-[var(--color-blue)] inline-block"
            ></span>
            Informe Clínico
          </h2>
          <div class="max-w-md">
            <div
              class="bg-gray-900 border border-gray-700 rounded-lg p-6 hover:border-[var(--color-blue)] transition-all duration-300"
            >
              <p class="text-gray-400 text-sm uppercase tracking-wide mb-2">
                Informe Clínico
              </p>
              <p class="text-white text-3xl font-extrabold">30€</p>
            </div>
          </div>
        </section>
        <section>
          <h2
            class="text-white font-bold text-2xl uppercase tracking-wide mb-6 flex items-center gap-3"
          >
            <span class="w-8 h-[2px] bg-[var(--color-blue)] inline-block"
            ></span>
            Preguntas frecuentes
          </h2>
          <div class="space-y-4">
            <article class="bg-gray-900 border border-gray-700 rounded-lg p-5">
              <h3 class="text-white font-bold mb-2">
                Cuanto cuesta la fisioterapia en Mislata?
              </h3>
              <p class="text-gray-300 text-sm">
                Puedes empezar desde 45 euros en sesion de seguimiento o elegir
                bonos y programas para reducir el coste por sesion.
              </p>
            </article>
            <article class="bg-gray-900 border border-gray-700 rounded-lg p-5">
              <h3 class="text-white font-bold mb-2">
                Trabajais recuperacion de lesiones deportivas?
              </h3>
              <p class="text-gray-300 text-sm">
                Si. Adaptamos el tratamiento y la readaptacion segun evolucion para
                volver a tu actividad con mayor seguridad.
              </p>
            </article>
          </div>
        </section>

        <section>
          <h2
            class="text-white font-bold text-2xl uppercase tracking-wide mb-6 flex items-center gap-3"
          >
            <span class="w-8 h-[2px] bg-[var(--color-blue)] inline-block"
            ></span>
            Bonos
          </h2>
          <div class="grid sm:grid-cols-2 gap-6 max-w-2xl">
            <PhysioVariantCard
              id="bono-05"
              label="Bono 05 Sesiones"
              priceCenter={215}
              priceDomicilio={240}
              noteCenter="43€ por sesión"
              noteDomicilio="48€ por sesión"
              popular
            />
            <PhysioVariantCard
              id="bono-10"
              label="Bono 10 Sesiones"
              priceCenter={420}
              priceDomicilio={470}
              noteCenter="42€ por sesión"
              noteDomicilio="47€ por sesión"
            />
          </div>
        </section>

        <section>
          <h2
            class="text-white font-bold text-2xl uppercase tracking-wide mb-6 flex items-center gap-3"
          >
            <span class="w-8 h-[2px] bg-[var(--color-blue)] inline-block"
            ></span>
            Programas
          </h2>
          <p class="text-gray-400 text-sm mb-6">
            * Los programas incluyen test + dinamometría + informe de evolución
          </p>
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
            <PhysioVariantCard
              id="programa-8-semanas"
              sublabel="8 Semanas"
              label="16 Sesiones"
              priceCenter={656}
              priceDomicilio={736}
              noteCenter="41€ por sesión"
              noteDomicilio="46€ por sesión"
              colorVar="--color-blue"
            />
            <PhysioVariantCard
              id="programa-12-semanas"
              sublabel="12 Semanas"
              label="24 Sesiones"
              priceCenter={960}
              priceDomicilio={1080}
              noteCenter="40€ por sesión"
              noteDomicilio="45€ por sesión"
              colorVar="--color-blue"
            />
            <PhysioVariantCard
              id="programa-24-semanas"
              sublabel="24 Semanas"
              label="48 Sesiones"
              priceCenter={1872}
              priceDomicilio={2112}
              noteCenter="39€ por sesión"
              noteDomicilio="44€ por sesión"
              colorVar="--color-blue"
            />
          </div>
        </section>

        <section>
          <div class="bg-gray-900 border border-gray-700 rounded-xl p-8">
            <h3
              class="text-white font-bold text-xl uppercase tracking-wide mb-4"
            >
              <span class="flex items-center gap-2">
                <span
                  class="w-6 h-6 bg-current flex-shrink-0"
                  style={`mask: url('${percent.src}') no-repeat center / contain; -webkit-mask: url('${percent.src}') no-repeat center / contain;`}
                  aria-hidden="true"></span>
                Descuentos Disponibles
              </span>
            </h3>
            <p class="text-gray-300 mb-4">
              Consulta nuestros descuentos por discapacidad, mayores de 65 años
              y más.
            </p>
            <Button href="/servicios/descuentos" variant="outline" color="blue">
              Ver Descuentos
              <span
                class="w-5 h-5 bg-current flex-shrink-0"
                style={`mask: url('${arrowRight.src}') no-repeat center / contain; -webkit-mask: url('${arrowRight.src}') no-repeat center / contain;`}
                aria-hidden="true"></span>
            </Button>
          </div>
        </section>
      </div>
    </div>
    <section class="py-16">
      <div class="max-w-7xl mx-auto px-6 md:px-12 text-center">
        <h2
          class="text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-wider text-white uppercase mb-6"
        >
          ¿Necesitas fisioterapia?
        </h2>
        <p class="text-gray-300 text-lg mb-8 max-w-2xl mx-auto">
          Cuéntanos tus objetivos y te contactamos para resolver tus dudas o
          agendar tu primera valoración.
        </p>
        <Button
          href="https://forms.gle/uSqz9QZFbJwnyZ5fA"
          target="_blank"
          rel="noopener noreferrer"
          ariaLabel="Solicitar información sobre fisioterapia en Mislata"
          color="blue"
          size="lg"
        >
          QUIERO INFORMACIÓN
        </Button>
      </div>
    </section>
  </main><ColorBar />
  <Footer /></Layout
>


